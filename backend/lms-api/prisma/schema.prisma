generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum EnrollmentStatus {
  IN_PROGRESS
  COMPLETED
}

enum CertType {
  PROFESSIONAL
  COURSE
}

enum EventType {
  LIVE_SESSION
  DEADLINE
  GOAL
}

enum QuizType {
  IN_LESSON
  MODULE
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  googleId  String?  @unique
  avatar    String?
  role      Role     @default(STUDENT)

  enrollments      Enrollment[]
  certificates     Certificate[]
  posts            CommunityPost[]
  events           CalendarEvent[]
  quizAttempts     QuizAttempt[]
  lessonProgresses LessonProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  icon      String
  courses   Course[]
}

model Course {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  description     String
  categoryId      String?
  category        Category?   @relation(fields: [categoryId], references: [id])
  categoryName    String
  instructorName  String
  instructorRole  String?
  price           Float       @default(0)
  level           CourseLevel @default(INTERMEDIATE)
  duration        String
  totalLessons    Int         @default(10)
  isFeatured      Boolean     @default(false)
  isTrending      Boolean     @default(false)
  badge           String?
  coverImage      String
  rating          Float       @default(5.0)
  reviewsCount    String      @default("0")
  studentsCount   Int         @default(0)

  enrollments     Enrollment[]
  modules         Module[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  orderIndex  Int      @default(0)

  lessons     Lesson[]
  quizzes     Quiz[]

  createdAt DateTime @default(now())
}

model Lesson {
  id          String   @id @default(cuid())
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  description String?
  youtubeUrl  String
  duration    String
  orderIndex  Int      @default(0)

  quizzes          Quiz[]
  lessonProgresses LessonProgress[]

  createdAt DateTime @default(now())
}

model Quiz {
  id            String   @id @default(cuid())
  moduleId      String?
  module        Module?  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessonId      String?
  lesson        Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title         String
  quizType      QuizType @default(IN_LESSON)
  passingScore  Int      @default(80)
  questions     String   // JSON string of questions array

  quizAttempts  QuizAttempt[]

  createdAt DateTime @default(now())
}

model QuizAttempt {
  id        String   @id @default(cuid())
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int
  passed    Boolean  @default(false)
  answers   String   // JSON string of user answers

  createdAt DateTime @default(now())
}

model LessonProgress {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completed Boolean  @default(false)

  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@unique([lessonId, userId])
}

model Enrollment {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId            String
  course             Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progressPercentage Int              @default(0)
  completedLessons   Int              @default(0)
  totalLessons       Int              @default(10)
  isBookmarked       Boolean          @default(false)
  status             EnrollmentStatus @default(IN_PROGRESS)

  enrolledAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Certificate {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  subTitle   String?
  type       CertType @default(COURSE)
  certNumber String   @unique
  issuedDate String
  pdfUrl     String?

  createdAt DateTime @default(now())
}

model CommunityPost {
  id            String   @id @default(cuid())
  authorId      String
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorName    String
  authorRole    String   @default("Student")
  channel       String   @default("#General")
  title         String
  content       String
  likesCount    Int      @default(0)
  commentsCount Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CalendarEvent {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  dateBadge   String
  dayNumber   String
  timeRange   String
  eventType   EventType @default(LIVE_SESSION)
  eventDate   DateTime  @default(now())

  createdAt DateTime @default(now())
}